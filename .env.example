# ---- API ----
API_BASE_URL=https://api.example.com
API_ENDPOINT=/v1/records
API_KEY=your_api_key_here
# Header used to send the key (e.g. X-API-Key, Authorization)
API_KEY_HEADER=X-API-Key
# Optional prefix for the header value (e.g. "Bearer"); leave empty for none
API_KEY_PREFIX=
API_TIMEOUT=30
# Key in each JSON record that uniquely identifies it
API_ID_FIELD=id
# Key holding the list of records in the response; leave empty if the response is a list
API_DATA_KEY=

# ---- MySQL (remote) ----
DB_HOST=your-remote-host.example.com
DB_PORT=3306
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=aca_analytics
# Optional path to a CA certificate for SSL connections
DB_SSL_CA=

# ---- Storage / logging ----
RAW_DATA_DIR=data/raw
LOG_LEVEL=INFO

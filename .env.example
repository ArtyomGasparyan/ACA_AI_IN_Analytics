# ---- API ----
# Mediastack via APILayer Marketplace
API_BASE_URL=https://api.apilayer.com
API_ENDPOINT=/media_stack/news
API_KEY=your_apilayer_api_key_here
# Header used to send the key (APILayer uses "apikey")
# Auth style A (APILayer marketplace): key sent in a header
API_KEY_HEADER=apikey
# Optional prefix for the header value (e.g. "Bearer"); leave empty for none
API_KEY_PREFIX=
# Auth style B (classic mediastack): key sent as query param; if set, header is not used
# e.g. API_BASE_URL=https://api.mediastack.com/v1, API_ENDPOINT=/news, API_KEY_PARAM=access_key
API_KEY_PARAM=
API_TIMEOUT=30
# Key in each JSON record that uniquely identifies it (news items have no id, use url)
API_ID_FIELD=url
# Key holding the list of records in the response; leave empty if the response is a list
API_DATA_KEY=data
# Optional query string, e.g. countries=us&languages=en&keywords=ai&limit=100
API_QUERY_PARAMS=languages=en&limit=100

# ---- MySQL (remote) ----
DB_HOST=your-remote-host.example.com
DB_PORT=3306
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=aca_analytics
# Optional path to a CA certificate for SSL connections
DB_SSL_CA=

# ---- Storage / logging ----
RAW_DATA_DIR=data/raw
LOG_LEVEL=INFO
